        "name": "plan",
        "index": 0
      },
      {
        "name": "ssn",
        "index": 1
      },
      {
        "name": "401k",
        "index": 4
      },
      {
        "name": "roth",
        "index": 5
      },
      {
        "name": "address1",
        "index": 20
      },
      {
        "name": "address2",
        "index": 21
      },
      {
        "name": "city",
