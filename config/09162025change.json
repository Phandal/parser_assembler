{
  "parser": {
    "kind": "csv",
    "skipLines": 0,
    "delimiter": ",",
    "trim": true,
    "fields": [
      {
        "name": "planid",
        "index": 0
      },
      {
        "name": "ssn",
        "index": 1
      },
      {
        "name": "401kAmount",
        "index": 4
      },
      {
        "name": "rothAmount",
        "index": 5
      },
      {
        "name": "addr1",
        "index": 20
      },
      {
        "name": "addr2",
        "index": 21
      },
      {
        "name": "city",
        "index": 22
      },
      {
        "name": "state",
        "index": 23
      },
      {
        "name": "zip",
        "index": 24
      },
      {
        "name": "effectiveDate",
        "index": 25
      }
    ]
  },
  "assembler": {
    "groupBy": "ssn",
    "rules": [
      {
        "take": {
          "sequence": "last"
        },
        "mergeInto": {
          "path": "ssn",
          "operation": "set",
          "output": "ssn"
        }
      },
      {
        "take": {
          "sequence": "last"
        },
        "mergeInto": {
          "path": "effectiveDate",
          "operation": "set",
          "output": "effectiveDate"
        }
      },
      {
        "when": {
          "field": "401kAmount",
          "notequals": ""
        },
        "mergeInto": {
          "path": "deferrals",
          "operation": "push",
          "output": {
            "type": {
              "_value": "401K"
            },
            "amount": "401kAmount"
          }
        }
      },
      {
        "when": {
          "field": "rothAmount",
          "notequals": ""
        },
        "mergeInto": {
          "path": "deferrals",
          "operation": "push",
          "output": {
            "type": {
              "_value": "ROTH"
            },
            "amount": "rothAmount"
          }
        }
      },
      {
        "take": {
          "sequence": "last"
        },
        "mergeInto": {
          "path": "demographic.addr1",
          "operation": "set",
          "output": "addr1"
        }
      },
      {
        "take": {
          "sequence": "last"
        },
        "mergeInto": {
          "path": "demographic.addr2",
          "operation": "set",
          "output": "addr2"
        }
      },
      {
        "take": {
          "sequence": "last"
        },
        "mergeInto": {
          "path": "demographic.city",
          "operation": "set",
          "output": "city"
        }
      },
      {
        "take": {
          "sequence": "last"
        },
        "mergeInto": {
          "path": "demographic.state",
          "operation": "set",
          "output": "state"
        }
      },
      {
        "take": {
          "sequence": "last"
        },
        "mergeInto": {
          "path": "demographic.zip",
          "operation": "set",
          "output": "zip"
        }
      }
    ]
  }
}
