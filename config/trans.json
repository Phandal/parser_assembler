{
  "parser": {
    "type": "csv",
    "delimiter": ",",
    "skipLines": 1,
    "trim": true,
    "fields": [
      {
        "name": "recordtype",
        "index": 0
      },
      {
        "name": "ssn",
        "index": 3
      },
      {
        "name": "effectiveDate",
        "index": 4
      },
      {
        "name": "code",
        "index": 6
      },
      {
        "name": "amount",
        "index": 8
      },
      {
        "name": "loanpayment",
        "index": 10
      }
    ]
  },
  "assembler": {
    "groupBy": "ssn",
    "mergeStrategy": {
      "ssn": "first",
      "effectivedate": "last",
      "changes": {
        "kind": "object-list",
        "valueMap": {},
        "output": {
          "key": "code",
          "keyName": "type",
          "value": "amount",
          "valueName": "value"
        }
      }
    },
    "transforms": {},
    "outputMapping": {
      "ssn": "ssn",
      "effectivedate": "effectivedate",
      "changes": "changes"
    }
  }
}
