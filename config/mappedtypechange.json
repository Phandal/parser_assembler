{
  "parser": {
    "type": "csv",
    "delimiter": ",",
    "skipLines": 1,
    "trim": true,
    "fields": [
      {
        "name": "ssn",
        "index": 0
      },
      {
        "name": "type",
        "index": 1
      },
      {
        "name": "change",
        "index": 2
      }
    ]
  },
  "assembler": {
    "groupBy": "ssn",
    "mergeStrategy": {
      "ssn": "first",
      "changes": {
        "kind": "object-list",
        "valueMap": {
          "type": {
            "1": "401k",
            "2": "roth",
            "3": "city"
          }
        },
        "output": {
          "key": "type",
          "keyName": "type",
          "value": "change",
          "valueName": "value"
        }
      }
    },
    "transforms": {},
    "outputMapping": {
      "member_ssn": "ssn",
      "changes": "changes"
    }
  }
}
