{
  "parser": {
    "type": "csv",
    "delimiter": ",",
    "skipLines": 1,
    "trim": true,
    "fields": [
      {
        "name": "ssn",
        "index": 0
      },
      {
        "name": "kind",
        "index": 1
      },
      {
        "name": "value",
        "index": 2
      }
    ]
  },
  "assembler": {
    "groupBy": "ssn",
    "mergeStrategy": {
      "ssn": "first",
      "changes": {
        "kind": "object-list",
        "valueMap": {},
        "output": {
          "key": "kind",
          "keyName": "type",
          "value": "value",
          "valueName": "value"
        }
      }
    },
    "transforms": {},
    "outputMapping": {
      "ssn": "ssn",
      "changes": "changes"
    }
  }
}
