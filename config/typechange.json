{
  "parser": {
    "type": "csv",
    "delimiter": ",",
    "skipLines": 1,
    "trim": true,
    "fields": [
      {
        "name": "ssn",
        "index": 0
      },
      {
        "name": "type",
        "index": 1
      },
      {
        "name": "amount",
        "index": 2
      }
    ]
  },
  "assembler": {
    "groupBy": "ssn",
    "mergeStrategy": {
      "ssn": "first",
      "changes": {
        "kind": "object-list",
        "fields": [
          "type",
          "amount"
        ]
      }
    },
    "transforms": {},
    "outputMapping": {
      "member_ssn": "ssn",
      "changes": "changes"
    }
  }
}
