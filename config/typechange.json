{
  "parser": {
    "kind": "csv",
    "skipLines": 1,
    "delimiter": ",",
    "trim": true,
    "fields": [
      {
        "name": "ssn",
        "index": 0
      },
      {
        "name": "type",
        "index": 1
      },
      {
        "name": "change",
        "index": 2
      }
    ]
  },
  "assembler": {
    "groupBy": "ssn",
    "rules": [
      {
        "take": {
          "sequence": "last"
        },
        "mergeInto": {
          "path": "ssn",
          "operation": "set",
          "output": "ssn"
        }
      },
      {
        "when": {
          "field": "type",
          "equals": "401k"
        },
        "mergeInto": {
          "path": "deferrals",
          "operation": "push",
          "output": {
            "type": {
              "_value": "401K"
            },
            "amount": "change"
          }
        }
      },
      {
        "when": {
          "field": "type",
          "equals": "roth"
        },
        "mergeInto": {
          "path": "deferrals",
          "operation": "push",
          "output": {
            "type": {
              "_value": "ROTH"
            },
            "amount": "change"
          }
        }
      },
      {
        "when": {
          "field": "type",
          "equals": "401k loan"
        },
        "mergeInto": {
          "path": "deferrals",
          "operation": "push",
          "output": {
            "type": {
              "_value": "LOAN"
            },
            "amount": "change"
          }
        }
      },
      {
        "when": {
          "field": "type",
          "equals": "city"
        },
        "mergeInto": {
          "path": "demographic.city",
          "operation": "set",
          "output": "change"
        }
      }
    ]
  }
}
