{
  "parser": {
    "type": "csv",
    "delimiter": ",",
    "skipLines": 1,
    "trim": true,
    "fields": [
      {
        "name": "ssn",
        "index": 0
      },
      {
        "name": "type",
        "index": 1
      },
      {
        "name": "change",
        "index": 2
      }
    ]
  },
  "assembler": {
    "groupBy": "ssn",
    "mergeStrategy": {
      "ssn": "first",
      "type": "list",
      "change": "list"
    },
    "transforms": {},
    "outputMapping": {
      "member_ssn": "ssn",
      "changes": [
        {
          "type": "type",
          "change": "change"
        }
      ]
    }
  }
}
