{
  "parser": {
    "kind": "csv",
    "delimiter": "|",
    "skipLines": 1,
    "trim": true,
    "fields": [
      {
        "name": "groupid",
        "index": 0
      },
      {
        "name": "ssn",
        "index": 1
      },
      {
        "name": "401k",
        "index": 2
      },
      {
        "name": "roth",
        "index": 3
      },
      {
        "name": "loan",
        "index": 4
      }
    ]
  },
  "assembler": {
    "groupBy": "ssn",
    "rules": [
      {
        "take": {
          "sequence": "last"
        },
        "mergeInto": {
          "path": "ssn",
          "operation": "set",
          "output": "ssn"
        }
      },
      {
        "when": {
          "field": "401k",
          "notequals": ""
        },
        "mergeInto": {
          "path": "deferrals",
          "operation": "push",
          "output": {
            "type": {
              "_value": "401K"
            },
            "amount": "401k"
          }
        }
      },
      {
        "when": {
          "field": "loan",
          "notequals": ""
        },
        "mergeInto": {
          "path": "deferrals",
          "operation": "push",
          "output": {
            "type": {
              "_value": "LOAN"
            },
            "amount": "loan"
          }
        }
      },
      {
        "when": {
          "field": "roth",
          "notequals": ""
        },
        "mergeInto": {
          "path": "deferrals",
          "operation": "push",
          "output": {
            "type": {
              "_value": "ROTH"
            },
            "amount": "roth"
          }
        }
      }
    ]
  }
}
